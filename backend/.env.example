DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mandap_booking?retryWrites=true&w=majority"
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# AWS S3
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Firebase (for FCM push notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Google Maps
GOOGLE_MAPS_API_KEY=""

# OTP / SMS (Msg91 or similar)
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_TEMPLATE_ID=""

# Platform defaults
PLATFORM_COMMISSION_PERCENT=10
ADVANCE_PAYMENT_PERCENT=30
BOOKING_HOLD_MINUTES=30
